                <div style="background-color: var(--bg-card); border: 1px solid var(--border); border-radius: 1rem; padding: 1.5rem;">
                    <h3><i class="fa-solid fa-comments" style="color: var(--accent);"></i> Foros del Club de Fans</h3>
                    <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem;">
                        <div class="sidebar-link" style="margin-bottom:0;" onclick="toast('Abriendo Foros de la Comunidad...')"><i class="fa-solid fa-globe"></i> Foros de la Comunidad</div>
                        <div class="sidebar-link" style="margin-bottom:0;" onclick="toast('Abriendo Foros Asociados...')"><i class="fa-solid fa-link"></i> Foros Asociados</div>
                        <div class="sidebar-link" style="margin-bottom:0;" onclick="toast('Abriendo Foros Oficiales del Club...')"><i class="fa-solid fa-shield-halved"></i> Foros Oficiales del Club de Fans</div>
                        ${club.privateForums.map((pf, idx) => `
                            <div class="sidebar-link" style="margin-bottom:0; border-color: var(--accent);" onclick="toast(${jsq('Abriendo foro privado: ' + pf)})">
                                <i class="fa-solid fa-lock"></i> Foro Privado: ${esc(pf)}
                                ${isOwnerOrManager ? `<button class="btn btn-danger" style="padding:0.1rem 0.6rem; font-size:0.7rem; margin-left:auto;" onclick="event.stopPropagation(); deletePrivateForum(${cid}, ${idx})">Eliminar</button>` : ''}
