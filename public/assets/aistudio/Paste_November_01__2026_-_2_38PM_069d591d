<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YM-ki Web - Foros y Comunidades</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-dark: #0f172a;
            --bg-card: #1e293b;
            --bg-hover: #334155;
            --primary: #6366f1;
            --primary-hover: color-mix(in srgb, var(--primary) 82%, #000);
            --primary-soft: color-mix(in srgb, var(--primary) 15%, transparent);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border: #334155;
            --accent: #ec4899;
            --coin-gold: #f59e0b;
            --verified-blue: #38bdf8;
            --danger: #ef4444;
        }

        body.light-theme {
            --bg-dark: #f1f5f9;
            --bg-card: #ffffff;
            --bg-hover: #e2e8f0;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border: #cbd5e1;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; }

        body { background-color: var(--bg-dark); color: var(--text-main); min-height: 100vh; display: flex; flex-direction: column; }

        .view { display: none; flex: 1; width: 100%; flex-direction: column; }
        .view.active { display: flex; }

        /* --- ETIQUETAS Y PERFILES --- */
        .badge-announcement { background-color: rgba(239, 68, 68, 0.2); color: var(--danger); border: 1px solid var(--danger); padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.7rem; font-weight: bold; }
        .verified-forum-badge { color: var(--verified-blue); margin-left: 0.3rem; }

        .pinned-announcement-banner {
            background: linear-gradient(135deg, var(--primary-soft), rgba(236, 72, 153, 0.2));
            border: 1px solid var(--primary);
            border-radius: 0.75rem; padding: 1rem; margin-bottom: 0.5rem; cursor: pointer; transition: transform 0.2s;
        }
        .pinned-announcement-banner:hover { transform: translateY(-2px); }

        .profile-preview-card {
            background-color: var(--bg-card); border: 1px solid var(--border); border-radius: 1rem; padding: 2rem;
            width: 100%; max-width: 400px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1rem; position: relative;
        }
        .profile-preview-avatar-wrapper { position: relative; width: 80px; height: 80px; margin: 0 auto; }
        .profile-preview-avatar { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; }
        .profile-preview-ring { position: absolute; top: 0; left: 0; width: 80px; height: 80px; border-radius: 50%; border: 3px solid var(--primary); pointer-events: none; background-size: cover; }

        .poll-option-btn { width: 100%; padding: 0.75rem; background-color: var(--bg-dark); border: 1px solid var(--border); border-radius: 0.5rem; color: var(--text-main); text-align: left; cursor: pointer; margin-bottom: 0.5rem; transition: background 0.2s; }
        .poll-option-btn:hover { background-color: var(--bg-hover); border-color: var(--primary); }
        .comment-box { background-color: var(--bg-dark); border-left: 3px solid var(--primary); padding: 0.75rem; border-radius: 0.3rem; margin-top: 0.5rem; }

        /* --- CLUBES DE FANS --- */
        .fans-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 1rem; }
        .fan-club-card { background-color: var(--bg-card); border: 1px solid var(--border); border-radius: 1rem; overflow: hidden; cursor: pointer; transition: transform 0.2s, border-color 0.2s; position: relative; display: flex; flex-direction: column; }
        .fan-club-card:hover { transform: translateY(-3px); border-color: var(--primary); }
        .fan-club-banner { width: 100%; height: 110px; object-fit: cover; background-color: var(--bg-hover); }
        .fan-club-body { padding: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; position: relative; margin-top: -30px; }
        .fan-club-avatar { width: 60px; height: 60px; border-radius: 50%; border: 3px solid var(--bg-card); object-fit: cover; background: var(--bg-dark); }

        .fandom-badge-pill { background-color: rgba(236, 72, 153, 0.15); color: var(--accent); border: 1px solid rgba(236, 72, 153, 0.3); padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; display: inline-flex; align-items: center; gap: 0.3rem; vertical-align: middle; }
        .fandom-badge-pill img { width: 14px; height: 14px; border-radius: 50%; object-fit: cover; }

        .artist-tag-chip { background-color: var(--bg-dark); border: 1px solid var(--border); padding: 0.25rem 0.5rem; border-radius: 0.3rem; font-size: 0.8rem; display: inline-flex; align-items: center; gap: 0.3rem; margin: 0.2rem; }
        .artist-tag-chip span { cursor: pointer; color: var(--danger); font-weight: bold; }

        .artist-preview-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; margin-top: 1rem; }
        .artist-mini-card { background-color: var(--bg-dark); border: 1px solid var(--border); border-radius: 0.75rem; padding: 1rem; text-align: center; cursor: pointer; transition: border-color 0.2s; }
        .artist-mini-card:hover { border-color: var(--primary); }

        /* --- LANDING Y AUTH --- */
        #landing-view {
            justify-content: center; align-items: center; text-align: center; padding: 2rem; min-height: 100vh;
            background: linear-gradient(135deg, #0f172a 0%, color-mix(in srgb, var(--primary) 30%, #0f172a) 100%);
        }
        .landing-title { font-size: 3.5rem; font-weight: 800; letter-spacing: -0.05em; margin-bottom: 1rem; background: linear-gradient(to right, var(--primary), #ec4899); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
        .landing-quote { font-size: 1.25rem; color: #94a3b8; max-width: 600px; margin-bottom: 2.5rem; font-style: italic; }
        .landing-buttons { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }

        .btn { background-color: var(--primary); color: white; border: none; padding: 0.85rem 2rem; font-size: 1rem; font-weight: 600; border-radius: 9999px; cursor: pointer; transition: all 0.2s ease; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }
        .btn:hover { background-color: var(--primary-hover); transform: translateY(-2px); }
        .btn-outline { background-color: transparent; border: 2px solid var(--border); color: var(--text-main); box-shadow: none; }
        .btn-outline:hover { background-color: var(--border); border-color: var(--text-muted); }
        .btn-danger { background-color: var(--danger); }
        .btn-danger:hover { background-color: #dc2626; }
        .btn[disabled] { opacity: 0.6; cursor: default; transform: none; }

        #auth-view { justify-content: center; align-items: center; padding: 2rem; min-height: 100vh; background: radial-gradient(circle at center, var(--bg-card) 0%, var(--bg-dark) 100%); }
        .auth-container { background-color: var(--bg-card); border: 1px solid var(--border); border-radius: 1rem; padding: 2.5rem; width: 100%; max-width: 420px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3); }
        .auth-header { display: flex; justify-content: space-between; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem; }
        .tab-btn { background: none; border: none; color: var(--text-muted); font-size: 1rem; font-weight: 600; cursor: pointer; padding-bottom: 0.25rem; position: relative; }
        .tab-btn.active { color: var(--text-main); }
        .tab-btn.active::after { content: ''; position: absolute; bottom: -1rem; left: 0; width: 100%; height: 2px; background-color: var(--primary); }

        .form-group, .modal-form-group { margin-bottom: 0; display: block; }
        .form-group { margin-bottom: 1.25rem; }
        .form-group label, .modal-form-group label { display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--text-muted); }
        .form-group input, .form-group textarea, .form-group select,
        .modal-form-group input[type="text"], .modal-form-group input[type="password"], .modal-form-group input[type="number"],
        .modal-form-group textarea, .modal-form-group select {
            width: 100%; padding: 0.75rem 1rem; background-color: var(--bg-dark); border: 1px solid var(--border); border-radius: 0.5rem; color: var(--text-main); font-size: 1rem;
        }
        .modal-form-group input[type="file"], .form-group input[type="file"] { width: 100%; color: var(--text-muted); font-size: 0.85rem; }
        .modal-form-group input[type="color"] { width: 100%; height: 40px; padding: 0.2rem; cursor: pointer; background: var(--bg-dark); border: 1px solid var(--border); border-radius: 0.5rem; }
        .modal-form-group textarea, .form-group textarea { min-height: 90px; resize: vertical; }
        .form-group input:focus, .form-group textarea:focus, .form-group select:focus,
        .modal-form-group input:focus, .modal-form-group textarea:focus, .modal-form-group select:focus { outline: none; border-color: var(--primary); }

        .auth-submit { width: 100%; padding: 0.75rem; background-color: var(--primary); color: white; border: none; border-radius: 0.5rem; font-weight: 600; font-size: 1rem; cursor: pointer; transition: background-color 0.2s; }
        .auth-submit:hover { background-color: var(--primary-hover); }
        .back-home { display: block; text-align: center; margin-top: 1.5rem; font-size: 0.85rem; color: var(--text-muted); text-decoration: none; }
        .form-panel { display: none; }
        .form-panel.active { display: block; }

        /* --- NAVBAR (alineada en una sola línea) --- */
        #dashboard-view { flex: 1; display: none; flex-direction: column; }
        #dashboard-view.active { display: flex; }

        .navbar {
            background-color: var(--bg-card); border-bottom: 1px solid var(--border);
            display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center;
            padding: 0.6rem 1.25rem; gap: 1rem; position: sticky; top: 0; z-index: 900;
        }
        .nav-left-group { display: flex; align-items: center; gap: 0.75rem; white-space: nowrap; }
        .menu-hamburger-btn { background: none; border: none; color: var(--text-main); font-size: 1.25rem; cursor: pointer; padding: 0.5rem; border-radius: 0.375rem; }
        .menu-hamburger-btn:hover { background-color: var(--bg-hover); }
        .nav-brand { font-weight: 700; font-size: 1.2rem; color: var(--text-main); }
        .nav-links { display: flex; gap: 0.5rem; justify-content: center; align-items: center; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
        .nav-links::-webkit-scrollbar { display: none; }
        .nav-item { background: none; border: none; color: var(--text-muted); font-size: 0.9rem; font-weight: 600; cursor: pointer; padding: 0.5rem 0.75rem; border-radius: 0.375rem; display: flex; align-items: center; gap: 0.5rem; white-space: nowrap; }
        .nav-item:hover { background-color: var(--bg-hover); color: var(--text-main); }
        .nav-item.active { color: var(--primary); background-color: var(--primary-soft); }
        .nav-right { display: flex; align-items: center; gap: 0.75rem; flex-wrap: nowrap; white-space: nowrap; }

        .coins-badge { background-color: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); padding: 0.35rem 0.75rem; border-radius: 9999px; display: flex; align-items: center; gap: 0.5rem; cursor: pointer; }
        .coins-badge i { color: var(--coin-gold); }
        .coins-count { font-weight: 700; font-size: 0.9rem; color: var(--coin-gold); }

        .notification-bell-btn { background: none; border: none; color: var(--text-muted); font-size: 1.15rem; cursor: pointer; position: relative; padding: 0.4rem 0.6rem; border-radius: 50%; }
        .notification-bell-btn:hover { background-color: var(--bg-hover); color: var(--text-main); }
        .notification-dot { position: absolute; top: 4px; right: 6px; width: 8px; height: 8px; background-color: var(--accent); border-radius: 50%; }

        .user-profile-btn { background: none; border: none; display: flex; align-items: center; gap: 0.6rem; cursor: pointer; padding: 0.25rem 0.5rem; border-radius: 9999px; color: var(--text-main); }
        .user-profile-btn:hover { background-color: var(--bg-hover); }
        .user-avatar-wrapper { position: relative; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .user-avatar { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }
        .avatar-ring { position: absolute; top: 0; left: 0; width: 40px; height: 40px; border-radius: 50%; border: 2px solid var(--primary); pointer-events: none; background-size: cover; }
        .user-name { display: inline-flex; align-items: center; max-width: 260px; overflow: hidden; white-space: nowrap; font-size: 0.9rem; font-weight: 600; color: var(--text-main); }

        .logout-btn { background-color: transparent; border: 1px solid var(--border); color: var(--text-muted); padding: 0.4rem 0.8rem; border-radius: 0.375rem; font-size: 0.85rem; cursor: pointer; }
        .logout-btn:hover { background-color: var(--border); color: var(--text-main); }

        @media (max-width: 900px) {
            .navbar { grid-template-columns: minmax(0, 1fr) auto; }
            .nav-links { grid-column: 1 / -1; grid-row: 2; justify-content: flex-start; }
            .nav-brand { display: none; }
            .user-name { max-width: 120px; }
        }

        .main-content { flex: 1; padding: 2rem; display: none; width: 100%; max-width: 950px; margin: 0 auto; flex-direction: column; gap: 1.5rem; }
        .content-section { display: none; width: 100%; flex-direction: column; gap: 1.5rem; }
        .content-section.active { display: flex; }

        .generic-placeholder { background-color: var(--bg-card); border: 2px dashed var(--border); border-radius: 1rem; justify-content: center; align-items: center; color: var(--text-muted); font-size: 1.1rem; display: flex; flex-direction: column; gap: 1rem; text-align: center; padding: 4rem 2rem; }
        .section-icon { font-size: 3rem; color: var(--primary); margin-bottom: 0.5rem; }

        /* --- MENÚ LATERAL --- */
        .sidebar-drawer { position: fixed; top: 0; left: -320px; width: 320px; max-width: 90vw; height: 100%; background-color: var(--bg-card); border-right: 1px solid var(--border); z-index: 1100; transition: left 0.3s ease; display: flex; flex-direction: column; box-shadow: 10px 0 25px rgba(0,0,0,0.5); }
        .sidebar-drawer.open { left: 0; }
        .sidebar-header { padding: 1.5rem; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
        .sidebar-body { padding: 1.5rem; display: flex; flex-direction: column; gap: 1.5rem; overflow-y: auto; flex: 1; }
        .sidebar-section h4 { font-size: 0.9rem; color: var(--primary); margin-bottom: 0.75rem; font-weight: 700; text-transform: uppercase; }
        .sidebar-link { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; color: var(--text-main); background-color: var(--bg-dark); border: 1px solid var(--border); border-radius: 0.5rem; cursor: pointer; margin-bottom: 0.5rem; font-size: 0.9rem; font-weight: 600; }
        .sidebar-link:hover { border-color: var(--primary); background-color: var(--bg-hover); }
        .drawer-backdrop { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(15, 23, 42, 0.7); backdrop-filter: blur(3px); display: none; z-index: 1050; }
        .drawer-backdrop.active { display: block; }

        /* --- FOROS --- */
        .forum-nav-tabs { display: flex; gap: 1rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; flex-wrap: wrap; }
        .forum-tab-btn { background: none; border: none; color: var(--text-muted); font-size: 1rem; font-weight: 600; cursor: pointer; padding: 0.5rem 1rem; border-radius: 0.375rem; }
        .forum-tab-btn.active { color: white; background-color: var(--primary); }
        .forum-subview { display: none; flex-direction: column; gap: 1.5rem; }
        .forum-subview.active { display: flex; }
        .forums-group-title { font-size: 1.1rem; font-weight: 700; color: var(--text-main); margin-top: 0.5rem; display: flex; align-items: center; gap: 0.5rem; }
        .forums-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem; }

        .forum-card { background-color: var(--bg-card); border: 1px solid var(--border); border-radius: 0.75rem; overflow: hidden; cursor: pointer; transition: transform 0.2s, border-color 0.2s; position: relative; }
        .forum-card:hover { transform: translateY(-3px); border-color: var(--primary); }
        .forum-banner { width: 100%; height: 100px; object-fit: cover; background-color: var(--bg-hover); display: block; }
        .forum-card-body { padding: 1rem; display: flex; flex-direction: column; gap: 0.5rem; position: relative; }
        .forum-avatar-mini { width: 50px; height: 50px; border-radius: 50%; border: 3px solid var(--bg-card); object-fit: cover; position: absolute; top: -35px; left: 1rem; }
        .forum-card-content { margin-top: 1rem; }
        .forum-card-title-row { display: flex; align-items: center; gap: 0.5rem; }
        .forum-card-title-row h3 { font-size: 1rem; font-weight: 700; color: var(--text-main); }
        .forum-card-desc { font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem; display: -webkit-box; line-clamp: 2; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .forum-card-stats { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem; display: flex; justify-content: space-between; }

        .forum-options-container { position: absolute; top: 1rem; right: 1rem; z-index: 20; }
        .forum-options-btn { background: rgba(15, 23, 42, 0.7); border: 1px solid var(--border); color: white; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; }
        .forum-dropdown-menu { position: absolute; top: 100%; right: 0; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: 0.5rem; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.4); display: none; flex-direction: column; width: 220px; z-index: 30; overflow: hidden; margin-top: 0.25rem; }
        .forum-dropdown-menu.active { display: flex; }
        .dropdown-item { background: none; border: none; text-align: left; padding: 0.75rem 1rem; font-size: 0.85rem; color: var(--text-main); cursor: pointer; display: flex; align-items: center; gap: 0.5rem; }
        .dropdown-item:hover { background-color: var(--bg-hover); }
        .dropdown-item.danger { color: var(--danger); }

        .forum-card-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(15, 23, 42, 0.85); backdrop-filter: blur(2px); display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 0.75rem; opacity: 0; pointer-events: none; transition: opacity 0.2s ease; z-index: 10; }
        .forum-card:hover .forum-card-overlay { opacity: 1; pointer-events: auto; }

        #forum-detail-view-container { width: 100%; border-radius: 1rem; overflow: hidden; }
        #forum-main-wrapper { border-radius: 1rem; background-size: cover; background-position: center; }
        .forum-detail-header { background-color: var(--bg-card); border: 1px solid var(--border); border-radius: 0.75rem; overflow: hidden; margin-bottom: 1.5rem; }
        .forum-detail-banner { width: 100%; height: 160px; object-fit: cover; background-color: var(--bg-hover); display: block; }
        .forum-detail-info { padding: 1.5rem; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem; position: relative; }
        .forum-detail-left { display: flex; gap: 1.25rem; align-items: center; margin-top: -50px; }
        .forum-detail-avatar { width: 80px; height: 80px; border-radius: 50%; border: 4px solid var(--bg-card); object-fit: cover; background-color: var(--bg-dark); }

        .create-post-bar { background-color: var(--bg-card); border: 1px solid var(--border); border-radius: 0.75rem; padding: 1rem 1.25rem; display: flex; align-items: center; gap: 1rem; cursor: pointer; }
        .create-post-bar img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
        .create-post-input-fake { flex: 1; background-color: var(--bg-dark); border: 1px solid var(--border); border-radius: 9999px; padding: 0.75rem 1.25rem; color: var(--text-muted); font-size: 0.95rem; }

        .forum-filters { display: flex; justify-content: space-between; align-items: center; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: 0.75rem; padding: 0.75rem 1.25rem; flex-wrap: wrap; gap: 1rem; }
        .filter-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }
        .tag-pill { background-color: var(--bg-dark); border: 1px solid var(--border); color: var(--text-muted); padding: 0.35rem 0.85rem; border-radius: 9999px; font-size: 0.85rem; cursor: pointer; }
        .tag-pill.active { background-color: var(--primary); border-color: var(--primary); color: white; }
        .filter-sorts { display: flex; gap: 0.5rem; }
        .sort-btn { background: none; border: none; color: var(--text-muted); font-size: 0.9rem; font-weight: 600; cursor: pointer; padding: 0.35rem 0.6rem; border-radius: 0.375rem; }
        .sort-btn.active { color: var(--primary); }

        .post-card { background-color: var(--bg-card); border: 1px solid var(--border); border-radius: 0.75rem; padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem; cursor: pointer; }
        .post-header { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
        .post-author-info { display: flex; align-items: center; gap: 0.75rem; cursor: pointer; }
        .post-author-avatar { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; }
        .post-meta-text h4 { font-size: 0.95rem; font-weight: 600; color: var(--text-main); }
        .post-meta-text span { font-size: 0.75rem; color: var(--text-muted); }
        .post-badge { background-color: var(--primary-soft); color: var(--primary); border: 1px solid var(--primary); padding: 0.25rem 0.65rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; }
        .post-body h3 { font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; }
        .post-body p { font-size: 0.95rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 0.75rem; }
        .post-footer { display: flex; gap: 1.5rem; border-top: 1px solid var(--border); padding-top: 0.75rem; font-size: 0.9rem; color: var(--text-muted); }
        .post-action-btn { background: none; border: none; color: var(--text-muted); display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 600; }
        .post-action-btn:hover { color: var(--primary); }
        .post-action-btn.liked { color: var(--accent); }

        /* --- CHATS --- */
        .chats-layout { display: grid; grid-template-columns: 280px 1fr; height: calc(100vh - 150px); min-height: 420px; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: 1rem; overflow: hidden; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3); }
        .chats-sidebar { background-color: var(--bg-dark); border-right: 1px solid var(--border); display: flex; flex-direction: column; min-height: 0; }
        .chats-sidebar-header { padding: 1.25rem; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
        .chats-list { overflow-y: auto; flex: 1; padding: 0.5rem; }
        .chat-contact-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border-radius: 0.5rem; cursor: pointer; }
        .chat-contact-item:hover, .chat-contact-item.active { background-color: var(--bg-hover); }
        .chat-main-panel { display: flex; flex-direction: column; background-color: var(--bg-card); min-height: 0; }
        .chat-header { padding: 1rem 1.25rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 1rem; }
        .chat-messages-area { flex: 1; padding: 1.25rem; overflow-y: auto; display: flex; flex-direction: column; gap: 1rem; background: radial-gradient(circle at center, var(--bg-card) 0%, var(--bg-dark) 100%); }
        .chat-message { max-width: 65%; padding: 0.75rem 1rem; border-radius: 0.75rem; font-size: 0.95rem; line-height: 1.4; word-break: break-word; }
        .chat-message.incoming { background-color: var(--bg-hover); color: var(--text-main); align-self: flex-start; }
        .chat-message.outgoing { background-color: var(--primary); color: white; align-self: flex-end; }
        .chat-input-area { padding: 1rem 1.25rem; border-top: 1px solid var(--border); display: flex; align-items: center; gap: 0.75rem; background-color: var(--bg-dark); }
        .chat-input-area input { flex: 1; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: 9999px; padding: 0.75rem 1.25rem; color: var(--text-main); }
        @media (max-width: 700px) {
            .chats-layout { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
            .chats-list { max-height: 120px; }
            .main-content { padding: 1rem; }
        }

        /* --- AUDICIONES (el degradado sigue el color principal) --- */
        .audition-panel-wrapper { display: flex; flex-direction: column; gap: 1.5rem; width: 100%; }
        .audition-hero-card {
            background: linear-gradient(135deg, color-mix(in srgb, var(--primary) 30%, var(--bg-dark)) 0%, color-mix(in srgb, var(--primary) 75%, var(--bg-dark)) 100%);
            border: 1px solid var(--primary); border-radius: 1rem; padding: 2.5rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3); color: #fff;
        }
        .audition-hero-card p { color: rgba(255,255,255,0.8); }
        .audition-hero-card .btn { background-color: #fff; color: var(--primary-hover); }
        .audition-hero-card .btn:hover { background-color: #f1f5f9; }
        .audition-rules-card, .audition-history-card { background-color: var(--bg-card); border: 1px solid var(--border); border-radius: 1rem; padding: 1.5rem 2rem; }
        .audition-form-page { display: none; background-color: var(--bg-card); border: 1px solid var(--border); border-radius: 1rem; padding: 2.5rem; flex-direction: column; gap: 1.5rem; }
        .audition-form-page.active { display: flex; }

        /* --- MODALES --- */
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(15, 23, 42, 0.8); backdrop-filter: blur(4px); display: none; justify-content: center; align-items: center; z-index: 2000; padding: 1rem; }
        .modal-overlay.active { display: flex; }
        #user-profile-preview-modal { z-index: 2100; }
        .modal-card { background-color: var(--bg-card); border: 1px solid var(--border); border-radius: 1rem; padding: 1.5rem; width: 100%; max-width: 520px; max-height: 90vh; overflow-y: auto; display: flex; flex-direction: column; gap: 1rem; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.4); }
        .modal-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; }
        .modal-header h3 { font-size: 1.15rem; font-weight: 700; }
        .close-modal { background: none; border: none; color: var(--text-muted); font-size: 1.6rem; line-height: 1; cursor: pointer; padding: 0 0.4rem; border-radius: 0.375rem; }
        .close-modal:hover { color: var(--text-main); background-color: var(--bg-hover); }
        .color-palette { display: flex; gap: 0.5rem; flex-wrap: wrap; }
        .color-palette .btn.selected { outline: 3px solid var(--text-main); outline-offset: 2px; }
        .img-preview { margin-top: 0.25rem; }

        #toast-container { position: fixed; bottom: 1.5rem; left: 50%; transform: translateX(-50%); z-index: 3000; display: flex; flex-direction: column; gap: 0.5rem; align-items: center; pointer-events: none; }
        .toast { background-color: var(--bg-card); color: var(--text-main); border: 1px solid var(--primary); border-radius: 0.75rem; padding: 0.75rem 1.25rem; box-shadow: 0 10px 25px rgba(0,0,0,0.4); font-size: 0.9rem; max-width: 90vw; }

        /* --- PERFIL --- */
        .profile-edit-container { background-color: var(--bg-card); border: 1px solid var(--border); border-radius: 1rem; padding: 2.5rem; max-width: 600px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.5rem; }
        .profile-banner-preview { width: 100%; height: 140px; border: 2px dashed var(--border); border-radius: 0.5rem; background-size: cover; background-position: center; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--text-muted); }
        .profile-avatar-preview-box { width: 90px; height: 90px; border-radius: 50%; border: 2px dashed var(--border); background-size: cover; background-position: center; display: flex; align-items: center; justify-content: center; cursor: pointer; overflow: hidden; color: var(--text-muted); flex-shrink: 0; }
    </style>
</head>
<body>

    <!-- 1. LANDING -->
    <div id="landing-view" class="view active">
        <h1 class="landing-title">YM-ki Web</h1>
        <p class="landing-quote">"Tu voz tiene el poder de conmover al mundo; atrévete a cruzar el umbral y deja que tu talento hable."</p>
        <div class="landing-buttons">
            <button class="btn" onclick="goToAuth('aspirante')"><i class="fa-solid fa-microphone-lines"></i> Audicionar</button>
            <button class="btn btn-outline" style="color:#f8fafc;" onclick="goToAuth('fan')"><i class="fa-solid fa-heart"></i> Entrar como fan</button>
        </div>
    </div>

    <!-- 2. AUTENTICACIÓN -->
    <div id="auth-view" class="view">
        <div class="auth-container">
            <div class="auth-header">
                <button class="tab-btn active" id="tab-login" onclick="switchTab('login')">Iniciar Sesión</button>
                <button class="tab-btn" id="tab-register" onclick="switchTab('register')">Registro</button>
            </div>

            <form id="form-login" class="form-panel active" onsubmit="handleLogin(event)">
                <div class="form-group">
                    <label for="login-id">Nombre de usuario / Correo electrónico</label>
                    <input type="text" id="login-id" required placeholder="Ingresa tu usuario o correo">
                </div>
                <div class="form-group">
                    <label for="login-pass">Contraseña</label>
                    <input type="password" id="login-pass" required placeholder="••••••••">
                </div>
                <button type="submit" class="auth-submit">Entrar</button>
                <a href="#" class="back-home" onclick="event.preventDefault(); goToLanding()">← Volver al inicio</a>
            </form>

            <form id="form-register" class="form-panel" onsubmit="handleRegister(event)">
                <div class="form-group">
                    <label for="reg-username">Nombre de usuario</label>
                    <input type="text" id="reg-username" required placeholder="Elige un nombre de usuario">
                </div>
                <div class="form-group">
                    <label for="reg-nickname">Nickname</label>
                    <input type="text" id="reg-nickname" required placeholder="Tu apodo artístico o público">
                </div>
                <div class="form-group">
                    <label for="reg-dob">Fecha de nacimiento</label>
                    <input type="date" id="reg-dob" required>
                </div>
                <button type="submit" class="auth-submit">Registrarse</button>
                <a href="#" class="back-home" onclick="event.preventDefault(); goToLanding()">← Volver al inicio</a>
            </form>
        </div>
    </div>

    <!-- MENÚ LATERAL -->
    <div class="drawer-backdrop" id="drawer-backdrop" onclick="closeSidebar()"></div>
    <div class="sidebar-drawer" id="sidebar-drawer">
        <div class="sidebar-header">
            <h3 style="font-weight: 700;"><i class="fa-solid fa-bars"></i> Menú de Cuenta</h3>
            <button class="close-modal" onclick="closeSidebar()">&times;</button>
        </div>
        <div class="sidebar-body">
            <div class="sidebar-section">
                <h4>Ajustes</h4>
                <div class="sidebar-link" onclick="closeSidebar(); openSettingsModal()"><i class="fa-solid fa-gear"></i> Configuración</div>
                <div class="sidebar-link" onclick="closeSidebar(); openProfileCustomizePage()"><i class="fa-solid fa-user"></i> Personalizar Perfil</div>
                <div class="sidebar-link" onclick="closeSidebar(); openPrivacyModal()"><i class="fa-solid fa-shield-halved"></i> Privacidad</div>
            </div>
            <div class="sidebar-section">
                <h4>Foros a los que te has unido</h4>
                <div id="sidebar-joined-forums-list" style="display: flex; flex-direction: column; gap: 0.5rem;"></div>
            </div>
        </div>
    </div>

    <!-- 3. DASHBOARD -->
    <div id="dashboard-view" class="view">
        <nav class="navbar">
            <div class="nav-left-group">
                <button class="menu-hamburger-btn" onclick="openSidebar()" title="Abrir menú"><i class="fa-solid fa-bars"></i></button>
                <div class="nav-brand"><i class="fa-solid fa-music"></i> YM-ki Web</div>
            </div>
            <div class="nav-links" id="nav-links-container"></div>
            <div class="nav-right">
                <button class="notification-bell-btn" onclick="openNotificationsModal()" title="Notificaciones">
                    <i class="fa-solid fa-bell"></i>
                    <span class="notification-dot" id="nav-notif-dot" style="display: none;"></span>
                </button>
                <div class="coins-badge" onclick="openCoinsPage()" title="Ver YM-Coins">
                    <i class="fa-solid fa-coins"></i>
                    <span class="coins-count" id="nav-coins-count">1,250</span>
                </div>
                <button class="user-profile-btn" onclick="openProfileCustomizePage()" title="Personalizar perfil">
                    <div class="user-avatar-wrapper">
                        <img src="" alt="Avatar" class="user-avatar" id="nav-avatar">
                        <div class="avatar-ring" id="nav-avatar-ring"></div>
                    </div>
                    <span class="user-name" id="nav-username">YM_User</span>
                </button>
                <button class="logout-btn" onclick="goToLanding()" title="Cerrar sesión"><i class="fa-solid fa-right-from-bracket"></i></button>
            </div>
        </nav>

        <main id="main-content-container" style="flex: 1; display: flex; flex-direction: column;">
            <!-- FOROS -->
            <div id="section-foros" class="main-content content-section active">
                <div class="forum-container" id="forum-main-wrapper" style="width: 100%;">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                        <div class="forum-nav-tabs">
                            <button class="forum-tab-btn active" id="tab-btn-feed" onclick="switchForumSubview('feed')"><i class="fa-solid fa-newspaper"></i> Publicaciones Globales</button>
                            <button class="forum-tab-btn" id="tab-btn-panel" onclick="switchForumSubview('panel')"><i class="fa-solid fa-layer-group"></i> Panel de Foros</button>
                        </div>
                        <button class="btn" style="padding: 0.5rem 1.25rem; font-size: 0.9rem;" onclick="openCreateForumModal()"><i class="fa-solid fa-folder-plus"></i> Crear Foro</button>
                    </div>

                    <div id="forum-subview-feed" class="forum-subview active" style="margin-top: 1rem;">
                        <div id="forum-detail-view-container" style="display: none;"></div>

                        <div id="feed-main-container">
                            <div class="create-post-bar" onclick="openCreatePostModal()">
                                <img src="" alt="Avatar" id="feed-create-avatar">
                                <div class="create-post-input-fake">¿Qué quieres compartir con la comunidad hoy?</div>
                                <button class="btn" style="padding: 0.5rem 1.25rem; font-size: 0.9rem;"><i class="fa-solid fa-plus"></i> Publicar</button>
                            </div>

                            <div class="forum-filters" style="margin-top: 1rem;">
                                <div class="filter-tags" id="tag-filters-container"></div>
                                <div class="filter-sorts">
                                    <button class="sort-btn active" onclick="sortBy('recent', this)"><i class="fa-solid fa-clock"></i> Recientes</button>
                                    <button class="sort-btn" onclick="sortBy('old', this)"><i class="fa-solid fa-hourglass-start"></i> Viejos</button>
                                    <button class="sort-btn" onclick="sortBy('controversial', this)"><i class="fa-solid fa-fire"></i> Controversiales</button>
                                </div>
                            </div>

                            <div id="posts-feed" style="display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem;"></div>
                        </div>
                    </div>

                    <div id="forum-subview-panel" class="forum-subview">
                        <h2 style="font-size: 1.25rem; font-weight: 700;">Panel de Foros</h2>
                        <p style="font-size: 0.9rem; color: var(--text-muted);">Organiza tus comunidades y descubre nuevas.</p>
                        <div class="forums-group-title"><i class="fa-solid fa-bookmark" style="color: var(--primary);"></i> Foros a los que te has unido</div>
                        <div class="forums-grid" id="forums-joined-grid"></div>
                        <div class="forums-group-title" style="margin-top: 1.5rem;"><i class="fa-solid fa-compass" style="color: var(--accent);"></i> Descubrir otros foros</div>
                        <div class="forums-grid" id="forums-discover-grid"></div>
                    </div>
                </div>
            </div>

            <!-- CHATS -->
            <div id="section-chats" class="main-content content-section">
                <div class="chats-layout" style="width: 100%;">
                    <div class="chats-sidebar">
                        <div class="chats-sidebar-header">
                            <h3 style="font-size: 1rem; font-weight: 700;"><i class="fa-solid fa-comments"></i> Mensajes</h3>
                            <button class="btn" style="padding: 0.35rem 0.75rem; font-size: 0.8rem;" onclick="openAddChatModal()" title="Nuevo chat"><i class="fa-solid fa-user-plus"></i></button>
                        </div>
                        <div class="chats-list" id="chats-contacts-list"></div>
                    </div>
                    <div class="chat-main-panel">
                        <div class="chat-header" id="active-chat-header"></div>
                        <div class="chat-messages-area" id="chat-messages-container"></div>
                        <div class="chat-input-area">
                            <input type="text" id="chat-message-input" placeholder="Escribe un mensaje..." onkeydown="handleChatKeydown(event)">
                            <button class="btn" style="padding: 0.75rem 1.5rem;" onclick="sendChatMessage()"><i class="fa-solid fa-paper-plane"></i></button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- AUDICIONES -->
            <div id="section-audiciones" class="main-content content-section">
                <div id="audition-panel-view" class="audition-panel-wrapper">
                    <div class="audition-hero-card">
                        <div>
                            <h2 style="font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem;">Centro de Audiciones YM-ki</h2>
                            <p>Da el gran salto hacia tu carrera artística. Postúlate en nuestras modalidades.</p>
                        </div>
                        <button class="btn" style="padding: 1rem 2.5rem; font-size: 1.1rem;" onclick="openAuditionFormPage()"><i class="fa-solid fa-paper-plane"></i> Postularse</button>
                    </div>

                    <div class="audition-rules-card">
                        <h2><i class="fa-solid fa-book-open" style="color: var(--primary);"></i> Normas y Reglas Oficiales de Audición</h2>
                        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem;">
                            <li><i class="fa-solid fa-circle-check" style="color: var(--primary);"></i> <strong>Edad:</strong> Todo aspirante debe ser mayor de 8 años cumplidos.</li>
                            <li><i class="fa-solid fa-circle-check" style="color: var(--primary);"></i> <strong>Vocal/Rap:</strong> Archivos ilimitados (máximo 4 minutos en total con tolerancia de 10s).</li>
                            <li><i class="fa-solid fa-circle-check" style="color: var(--primary);"></i> <strong>Originalidad:</strong> Material 100% interpretado por el postulante.</li>
                        </ul>
                    </div>

                    <div class="audition-history-card">
                        <h2><i class="fa-solid fa-clipboard-list" style="color: var(--accent);"></i> Mis Audiciones Enviadas y Respuestas</h2>
                        <div id="audition-submissions-list" style="display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem;"></div>
                    </div>
                </div>

                <div id="audition-form-view" class="audition-form-page">
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 1rem; gap: 1rem; flex-wrap: wrap;">
                        <h3 style="font-size: 1.5rem; font-weight: 800;"><i class="fa-solid fa-file-pen" style="color: var(--primary);"></i> Formulario Oficial de Postulación</h3>
                        <button class="btn btn-outline" style="padding: 0.4rem 1rem; font-size: 0.85rem;" onclick="closeAuditionFormPage()">← Volver</button>
                    </div>
                    <form id="form-audition-submit" onsubmit="handleAuditionSubmit(event)" style="display: flex; flex-direction: column; gap: 1.25rem;">
                        <div class="form-group" style="margin-bottom:0;">
                            <label for="audition-modalidad">Seleccionar Modalidad</label>
                            <select id="audition-modalidad" onchange="renderAuditionFields(this.value)" required>
                                <option value="vocal-rap">Vocal / Rap</option>
                                <option value="bailarin">Bailarín</option>
                                <option value="staff">Staff</option>
                                <option value="mixta">Mixta</option>
                            </select>
                        </div>
                        <div id="dynamic-audition-fields" style="display: flex; flex-direction: column; gap: 1.25rem;"></div>
                        <button type="submit" class="auth-submit"><i class="fa-solid fa-paper-plane"></i> Enviar Postulación al CEO</button>
                    </form>
                </div>
            </div>

            <!-- FANS -->
            <div id="section-fans" class="main-content content-section">
                <div id="fans-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                    <div>
                        <h2 style="font-size: 1.5rem; font-weight: 800;"><i class="fa-solid fa-star" style="color: var(--coin-gold);"></i> Clubes de Fans Oficiales</h2>
                        <p style="font-size: 0.9rem; color: var(--text-muted);">Apoya de cerca a tus artistas favoritos, únete a comunidades y descubre contenido exclusivo.</p>
                    </div>
                    <button class="btn" id="create-fan-club-btn" style="display: none;" onclick="openCreateFanClubModal()"><i class="fa-solid fa-plus"></i> Crear Club de Fans</button>
                </div>

                <div class="fans-grid" id="fan-clubs-grid"></div>

                <div id="fan-club-detail-view" style="display: none; flex-direction: column; gap: 1.5rem;">
                    <button class="btn btn-outline" style="align-self: flex-start; padding: 0.4rem 1rem; font-size: 0.85rem;" onclick="closeFanClubDetail()">← Volver a Clubes</button>
                    <div id="fan-club-detail-content" style="display:flex; flex-direction:column; gap:1.5rem;"></div>
                </div>

                <div id="artist-profile-amplified-view" style="display: none; flex-direction: column; gap: 1.5rem;">
                    <button class="btn btn-outline" style="align-self: flex-start; padding: 0.4rem 1rem; font-size: 0.85rem;" onclick="closeArtistAmplifiedView()">← Volver al Club</button>
                    <div id="artist-amplified-content" class="modal-card" style="max-width: 100%;"></div>
                </div>
            </div>

            <div id="section-tienda" class="main-content content-section"><div class="generic-placeholder"><i class="fa-solid fa-store section-icon"></i><h2>Tienda</h2><p>Mejoras y pases</p></div></div>
            <div id="section-coins-page" class="main-content content-section"><div class="generic-placeholder"><i class="fa-solid fa-coins section-icon" style="color: var(--coin-gold);"></i><h2>Cartera</h2><p id="coins-page-amount">1,250 Coins</p><button class="btn" style="margin-top:1rem;" onclick="switchSection('foros')">← Volver</button></div></div>
            <div id="section-profile-page" class="main-content content-section"><div class="generic-placeholder"><h2 id="profile-display-name">YM_User</h2><p id="profile-display-desc">Descripción</p><button class="btn" style="margin-top:1rem;" onclick="openProfileCustomizePage()">Personalizar Perfil</button></div></div>

            <!-- PERSONALIZAR PERFIL -->
            <div id="section-profile-customize" class="main-content content-section">
                <div class="profile-edit-container" style="width: 100%;">
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 1rem; gap: 1rem; flex-wrap: wrap;">
                        <h3 style="font-size: 1.5rem; font-weight: 800;"><i class="fa-solid fa-user-gear" style="color: var(--primary);"></i> Configuración y Perfil</h3>
                        <button class="btn btn-outline" style="padding: 0.4rem 1rem; font-size: 0.85rem;" onclick="switchSection('foros')">← Volver</button>
                    </div>

                    <div class="modal-form-group" id="artist-admin-customization-fields" style="display: none;">
                        <label style="color: var(--primary); font-weight: bold;"><i class="fa-solid fa-star"></i> Opciones exclusivas de Artista / Administrador</label>
                        <div style="margin-top: 0.5rem;" class="modal-form-group">
                            <label for="profile-bg-color-input">Color de Fondo del Perfil</label>
                            <input type="color" id="profile-bg-color-input" value="#1e293b">
                        </div>
                        <div style="margin-top: 0.75rem;" class="modal-form-group">
                            <label>Importar Marco Transparente (PNG)</label>
                            <input type="file" id="profile-frame-file" accept="image/png" onchange="pickImage(this, 'pfFrame', 'frame-preview', 256, 256, 'image/png')">
                            <div id="frame-preview" class="img-preview"></div>
                        </div>
                        <div style="margin-top: 0.75rem; display: flex; gap: 1rem;">
                            <div style="flex: 1;" class="modal-form-group">
                                <label for="badge-admin-color-input">Color Corona / Micrófono</label>
                                <input type="color" id="badge-admin-color-input" value="#ec4899">
                            </div>
                            <div style="flex: 1;" class="modal-form-group">
                                <label for="badge-verified-color-input">Color Verificado</label>
                                <input type="color" id="badge-verified-color-input" value="#38bdf8">
                            </div>
                        </div>
                        <div style="margin-top: 0.75rem;" class="modal-form-group">
                            <label for="artist-animal-input">Animal Representativo</label>
                            <input type="text" id="artist-animal-input" placeholder="Ej: Zorro 🦊">
                        </div>
                        <div style="margin-top: 0.75rem;" class="modal-form-group">
                            <label style="display:flex; align-items:center; gap:0.5rem; color: var(--text-main);"><input type="checkbox" id="artist-allow-messages" checked> Permitir mensajes de fans</label>
                        </div>
