        /* ===================== FOROS ===================== */
        function switchForumSubview(subview) {
            document.querySelectorAll('.forum-tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.forum-subview').forEach(s => s.classList.remove('active'));
            document.getElementById('feed-main-container').style.display = 'block';

            if (subview === 'feed') {
                document.getElementById('tab-btn-feed').classList.add('active');
                document.getElementById('forum-subview-feed').classList.add('active');
                activeForumFilter = null;
                document.getElementById('forum-detail-view-container').style.display = 'none';
                const w = document.getElementById('forum-main-wrapper');
                w.style.background = 'none'; w.style.padding = '0';
                renderTags(); renderPosts();
            } else if (subview === 'panel') {
                document.getElementById('tab-btn-panel').classList.add('active');
                document.getElementById('forum-subview-panel').classList.add('active');
                renderForumsPanel();
            }
