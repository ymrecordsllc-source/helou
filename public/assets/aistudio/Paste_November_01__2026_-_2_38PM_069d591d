            document.getElementById('artist-profile-amplified-view').style.display = 'none';
            document.getElementById('fan-club-detail-view').style.display = 'flex';
        }

        function openEditArtistModal(artistName) {
            const prof = getProfileOf(artistName);
            document.getElementById('edit-artist-name').value = artistName;
            document.getElementById('edit-artist-animal').value = prof.animal || '';
            document.getElementById('edit-artist-allow').checked = prof.allowMessages !== false;
            document.getElementById('edit-artist-modal').classList.add('active');
