                    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                        <button class="btn btn-outline" style="font-size: 0.85rem;" onclick="toast('Club silenciado.')">Silenciar club</button>
                        <button class="btn btn-outline" style="font-size: 0.85rem; border-color: var(--danger); color: var(--danger);" onclick="toast('Club reportado.')">Reportar club</button>
