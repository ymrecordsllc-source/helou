        };

        function renderAuditionFields(modalidad) {
            const box = document.getElementById('dynamic-audition-fields');
            if (modalidad === 'vocal-rap') box.innerHTML = AUDITION_FIELDS.vocal;
            else if (modalidad === 'bailarin') box.innerHTML = AUDITION_FIELDS.dance;
            else if (modalidad === 'staff') box.innerHTML = AUDITION_FIELDS.staff;
            else box.innerHTML = AUDITION_FIELDS.vocal + AUDITION_FIELDS.dance;
        }

        function openAuditionFormPage() {
            document.getElementById('audition-modalidad').value = 'vocal-rap';
            renderAuditionFields('vocal-rap');
            document.getElementById('audition-panel-view').style.display = 'none';
            document.getElementById('audition-form-view').classList.add('active');
        }
        function closeAuditionFormPage() {
            document.getElementById('audition-form-view').classList.remove('active');
            document.getElementById('audition-panel-view').style.display = 'flex';
        }

        function calcAge(dob) {
            if (!dob) return null;
            const d = new Date(dob); if (isNaN(d)) return null;
            const t = new Date();
            let age = t.getFullYear() - d.getFullYear();
            if (t < new Date(t.getFullYear(), d.getMonth(), d.getDate())) age--;
            return age;
        }

        async function handleAuditionSubmit(e) {
            e.preventDefault();
            const age = calcAge(userProfile.dob);
            if (age !== null && age < 8) { toast('Debes tener al menos 8 años cumplidos para audicionar.'); return; }

            const modalidad = document.getElementById('audition-modalidad').value;
            const labels = { 'vocal-rap': 'Vocal / Rap', bailarin: 'Bailarín', staff: 'Staff', mixta: 'Mixta' };
            const names = [];
            const vocalInput = document.getElementById('aud-vocal-files');
            if (vocalInput) {
                let total = 0;
                for (const f of vocalInput.files) { total += await getMediaDuration(f); names.push(f.name); }
                if (total > MAX_VOCAL_SECONDS) { toast(`Los archivos suman ${Math.round(total)} s. El máximo es 4 minutos (+10 s de tolerancia).`); return; }
            }
            ['aud-dance-files', 'aud-staff-files'].forEach(id => {
                const inp = document.getElementById(id);
                if (inp) for (const f of inp.files) names.push(f.name);
            });
            const pseud = document.getElementById('aud-pseudonym');

            userProfile.auditions = userProfile.auditions || [];
            userProfile.auditions.unshift({
                id: Date.now(), modalidad: labels[modalidad], pseudonym: pseud ? pseud.value.trim() : '',
                files: names, date: new Date().toISOString(), status: 'En revisión', evaluator: 'CEO Miki'
            });
            saveToLocalStorage();
            toast('¡Postulación enviada al CEO!');
            closeAuditionFormPage();
            renderAuditionSubmissions();
        }

        function renderAuditionSubmissions() {
            const list = document.getElementById('audition-submissions-list');
            const subs = userProfile.auditions || [];
            if (!subs.length) {
                list.innerHTML = `<div style="color: var(--text-muted); font-size: 0.9rem;">Aún no has enviado ninguna audición. Presiona «Postularse» para empezar.</div>`;
                return;
            }
            list.innerHTML = subs.map(s => `
                <div style="background-color: var(--bg-dark); border: 1px solid var(--border); border-radius: 0.75rem; padding: 1.25rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
                    <div>
                        <h4 style="font-weight: 700;">Modalidad: ${esc(s.modalidad)}${s.pseudonym ? ` (Seudónimo: ${esc(s.pseudonym)})` : ''}</h4>
                        <p style="font-size: 0.85rem; color: var(--text-muted);">Evaluado por: ${esc(s.evaluator)} · ${new Date(s.date).toLocaleDateString('es-MX')} · ${s.files.length} archivo(s)</p>
                    </div>
                    <span style="background-color: var(--primary-soft); color: var(--primary); padding: 0.35rem 0.85rem; border-radius: 9999px; font-size: 0.85rem; font-weight: 600;">${esc(s.status)}</span>
                </div>`).join('');
        }

        /* ===================== CLUBES DE FANS ===================== */
        function checkFanClubPermissions() {
            const btn = document.getElementById('create-fan-club-btn');
            if (btn) btn.style.display = (isUserAdmin(currentUsername) || isUserArtist(currentUsername)) ? 'inline-block' : 'none';
        }

        function resetFanViews() {
            document.getElementById('fan-club-detail-view').style.display = 'none';
            document.getElementById('artist-profile-amplified-view').style.display = 'none';
            document.getElementById('fan-clubs-grid').style.display = 'grid';
            document.getElementById('fans-header').style.display = 'flex';
            activeClubId = null;
        }

        function openCreateFanClubModal() {
            tempAssociatedArtists = [];
            document.getElementById('form-create-fan-club').reset();
            resetPending(['fcIcon', 'fcBanner', 'fcAvatar'], ['fc-icon-preview', 'fc-banner-preview', 'fc-avatar-preview']);
            document.getElementById('fc-manager').value = currentUsername;
            document.getElementById('fc-artists-tags-container').innerHTML = '';
            document.getElementById('create-fan-club-modal').classList.add('active');
        }
        function closeCreateFanClubModal() { document.getElementById('create-fan-club-modal').classList.remove('active'); }

        function handleArtistInputKeydown(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const val = e.target.value.trim();
                if (val && !tempAssociatedArtists.includes(val)) {
                    tempAssociatedArtists.push(val);
                    renderArtistTags();
                    e.target.value = '';
                }
            }
        }
        function renderArtistTags() {
            const container = document.getElementById('fc-artists-tags-container');
            container.innerHTML = '';
            tempAssociatedArtists.forEach((art, index) => {
                const chip = document.createElement('div');
                chip.className = 'artist-tag-chip';
                chip.innerHTML = `${esc(art)} <span onclick="removeArtistTag(${index})">&times;</span>`;
                container.appendChild(chip);
            });
        }
        function removeArtistTag(index) { tempAssociatedArtists.splice(index, 1); renderArtistTags(); }

        function handleCreateFanClub(e) {
            e.preventDefault();
            // Si quedó un artista escrito sin presionar Enter, se añade automáticamente
            const pendingArtist = document.getElementById('fc-artist-input').value.trim();
            if (pendingArtist && !tempAssociatedArtists.includes(pendingArtist)) tempAssociatedArtists.push(pendingArtist);
            if (tempAssociatedArtists.length === 0) { toast('Añade al menos un artista asociado (escribe el usuario y presiona Enter).'); return; }

            const price = parseFloat(document.getElementById('fc-price').value);
            fanClubsData.push({
                id: Date.now().toString(),
                name: document.getElementById('fc-name').value.trim(),
                fandomName: document.getElementById('fc-fandom').value.trim(),
                artists: [...tempAssociatedArtists],
                manager: document.getElementById('fc-manager').value.trim(),
                messagePrice: isNaN(price) ? 10 : price,
                tagIcon: '⭐',
                tagIconImg: pending.fcIcon || '',
                tagColor: '',
                description: document.getElementById('fc-desc').value.trim(),
                banner: pending.fcBanner || DEFAULT_BANNER,
                avatar: pending.fcAvatar || DEFAULT_FORUM_AVATAR,
                privateForums: [], members: [currentUsername], isMuted: false
            });
            saveToLocalStorage();
            closeCreateFanClubModal();
            renderFanClubsGrid();
            updateUserUI();
            toast('¡Club de fans creado exitosamente!');
        }

        function renderFanClubsGrid() {
            checkFanClubPermissions();
            const grid = document.getElementById('fan-clubs-grid');
            grid.innerHTML = '';
            if (fanClubsData.length === 0) {
                grid.innerHTML = `<div style="text-align: center; color: var(--text-muted); grid-column: 1/-1; padding: 3rem;">No hay clubes de fans creados todavía.</div>`;
                return;
            }
            fanClubsData.forEach(club => {
                const card = document.createElement('div');
