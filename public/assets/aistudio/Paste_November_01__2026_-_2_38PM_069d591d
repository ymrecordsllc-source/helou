    <div id="toast-container"></div>

    <script>
        /* ===================== UTILIDADES ===================== */
        const DEFAULT_AVATAR = 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&h=100&fit=crop&crop=faces';
        const DEFAULT_BANNER = 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=600&h=200&fit=crop';
        const DEFAULT_FORUM_AVATAR = 'https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=100&h=100&fit=crop';

        function esc(s) {
            return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }
        // Convierte un valor en un literal JS seguro para usar dentro de atributos onclick="..."
        function jsq(s) { return esc(JSON.stringify(String(s))); }
        function load(key, fallback) {
            try { const v = JSON.parse(localStorage.getItem(key)); return v == null ? fallback : v; }
            catch (e) { return fallback; }
        }
        function toast(msg) {
            const box = document.getElementById('toast-container');
            const t = document.createElement('div');
            t.className = 'toast';
            t.textContent = msg;
            box.appendChild(t);
            setTimeout(() => t.remove(), 3200);
        }

        /* ===================== IMPORTACIÓN DE IMÁGENES ===================== */
        const pending = {}; // imágenes elegidas y aún no guardadas

        function fileToDataURL(file, maxW, maxH, mime) {
            return new Promise((resolve, reject) => {
                if (!file || !file.type.startsWith('image/')) { reject(new Error('El archivo no es una imagen válida.')); return; }
                const reader = new FileReader();
                reader.onerror = () => reject(new Error('No se pudo leer el archivo.'));
                reader.onload = () => {
                    const img = new Image();
                    img.onerror = () => reject(new Error('No se pudo cargar la imagen.'));
                    img.onload = () => {
                        const ratio = Math.min(1, maxW / img.width, maxH / img.height);
                        const c = document.createElement('canvas');
                        c.width = Math.max(1, Math.round(img.width * ratio));
                        c.height = Math.max(1, Math.round(img.height * ratio));
                        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
                        resolve(c.toDataURL(mime, 0.85));
                    };
                    img.src = reader.result;
                };
                reader.readAsDataURL(file);
            });
        }

        async function pickImage(input, key, previewId, maxW, maxH, mime) {
            const f = input.files && input.files[0];
            if (!f) return;
            try {
                const url = await fileToDataURL(f, maxW || 800, maxH || 800, mime || 'image/jpeg');
                pending[key] = url;
                showPreview(previewId, url);
            } catch (e) {
                toast(e.message);
                input.value = '';
            }
        }

        function showPreview(id, url) {
            const el = document.getElementById(id);
            if (!el) return;
            if (el.dataset.mode === 'bg') {
                el.style.backgroundImage = `url("${url}")`;
                const s = el.querySelector('span'); if (s) s.style.display = 'none';
            } else {
                el.innerHTML = `<img src="${url}" alt="" style="max-height:64px; max-width:100%; border-radius:0.4rem; background: var(--bg-dark);">`;
            }
        }
        function clearPreview(id) {
            const el = document.getElementById(id);
            if (!el) return;
            if (el.dataset.mode === 'bg') {
                el.style.backgroundImage = 'none';
                const s = el.querySelector('span'); if (s) s.style.display = '';
            } else { el.innerHTML = ''; }
        }
        function resetPending(keys, previewIds, fileInputIds) {
            keys.forEach(k => { pending[k] = null; });
            (previewIds || []).forEach(clearPreview);
            (fileInputIds || []).forEach(id => { const e = document.getElementById(id); if (e) e.value = ''; });
        }

        /* ===================== ESTADO ===================== */
        let currentRole = 'aspirante';
        let currentUsername = 'YM_User';
        let currentTagFilter = 'all';
        let currentSortMode = 'recent';
        let activeForumFilter = null;
        let viewingUserId = null;
        let currentOpenPostId = null;

        let adminUsers = load('ym_admins', ['Administración', 'CEO Miki', 'Admin']);

        function defaultProfile(username) {
            return {
                avatar: DEFAULT_AVATAR, banner: DEFAULT_BANNER,
                description: 'Perfil de usuario y configuración de cuenta',
                ringColor: '#6366f1', nickname: username, isArtist: false,
                profileBgColor: '#1e293b', transparentFrame: null,
