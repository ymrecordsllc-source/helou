        function renderFandomBadge(club, label = 'Fandom: ') {
            const icon = club.tagIconImg ? `<img src="${esc(club.tagIconImg)}" alt="">` : esc(club.tagIcon || '⭐');
            const colorStyle = club.tagColor ? `background-color: ${esc(club.tagColor)}; color: #fff; border-color: ${esc(club.tagColor)};` : '';
            return `<span class="fandom-badge-pill" style="${colorStyle}">${icon} ${esc(label)}${esc(club.fandomName)}</span>`;
        }

        function renderUserBadges(username) {
            let badges = '';
            const prof = getProfileOf(username);
            const adminColor = esc(prof.badgeAdminColor || '#ec4899');
            const verifiedColor = esc(prof.badgeVerifiedColor || '#38bdf8');

            if (isUserAdmin(username)) {
                badges += `<i class="fa-solid fa-crown" style="color: ${adminColor}; margin-left: 0.3rem;" title="Administrador"></i>`;
                badges += `<i class="fa-solid fa-circle-check" style="color: ${verifiedColor}; margin-left: 0.3rem;" title="Verificado"></i>`;
            } else if (isUserArtist(username)) {
                badges += `<i class="fa-solid fa-microphone" style="color: ${adminColor}; margin-left: 0.3rem;" title="Artista"></i>`;
                badges += `<i class="fa-solid fa-circle-check" style="color: ${verifiedColor}; margin-left: 0.3rem;" title="Verificado"></i>`;
            }

            fanClubsData.forEach(club => {
                if (club.members && club.members.includes(username)) {
                    const bg = esc(club.tagColor || '#ec4899');
                    const icon = club.tagIconImg ? `<img src="${esc(club.tagIconImg)}" alt="">` : esc(club.tagIcon || '⭐');
                    badges += ` <span class="fandom-badge-pill" style="margin-left:0.3rem; font-size: 0.7rem; padding: 0.1rem 0.5rem; background-color: ${bg}; color: #fff; border: none;">${icon} ${esc(club.fandomName)}</span>`;
                }
            });
            return badges;
        }

        function updateUserUI() {
