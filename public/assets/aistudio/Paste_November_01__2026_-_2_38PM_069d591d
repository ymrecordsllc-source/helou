        function closeEditArtistModal() { document.getElementById('edit-artist-modal').classList.remove('active'); }
        function saveArtistDetails(e) {
            e.preventDefault();
            const name = document.getElementById('edit-artist-name').value;
            updateProfileOf(name, {
                animal: document.getElementById('edit-artist-animal').value.trim(),
                allowMessages: document.getElementById('edit-artist-allow').checked
            });
            closeEditArtistModal();
            openArtistAmplifiedView(name);
            toast('¡Detalles de artista actualizados!');
