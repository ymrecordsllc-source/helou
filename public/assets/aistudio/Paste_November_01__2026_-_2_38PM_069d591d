        function openPaidMessageModal(artistName, price) {
            currentPaidArtistName = artistName;
            currentClubPrice = price;
            document.getElementById('paid-modal-title').textContent = `Enviar Mensaje a ${artistName}`;
            document.getElementById('paid-modal-cost-text').textContent = `Costo por este mensaje exclusivo: ${price} Monedas (saldo: ${userProfile.coins || 0})`;
            document.getElementById('paid-msg-content').value = '';
            document.getElementById('paid-message-modal').classList.add('active');
        }
        function closePaidMessageModal() { document.getElementById('paid-message-modal').classList.remove('active'); }
        function submitPaidArtistMessage() {
            const msg = document.getElementById('paid-msg-content').value.trim();
            if (!msg) { toast('Escribe un mensaje antes de enviar.'); return; }
            if ((userProfile.coins || 0) < currentClubPrice) { toast('No tienes suficientes monedas.'); return; }
            userProfile.coins -= currentClubPrice;
            saveToLocalStorage(); updateUserUI();
            toast(`¡Mensaje enviado a ${currentPaidArtistName}! Se descontaron ${currentClubPrice} monedas.`);
            closePaidMessageModal();
        }

        function joinClubMembers(clubId) {
            const club = fanClubsData.find(c => c.id === clubId);
            if (!club) return;
            if (club.members.includes(currentUsername)) { toast('Ya eres miembro de este club.'); return; }
            club.members.push(currentUsername);
            saveToLocalStorage();
            updateUserUI();
            openFanClubDetail(clubId);
            toast(`¡Te has unido al club y ahora portas la etiqueta ${club.fandomName}!`);
        }

        function leaveFanClub(clubId) {
            const club = fanClubsData.find(c => c.id === clubId);
            if (!club) return;
            club.members = club.members.filter(m => m !== currentUsername);
            saveToLocalStorage();
            updateUserUI();
            closeFanClubDetail();
            toast('Has salido del club de fans.');
        }

        function addPrivateForum(clubId) {
            const club = fanClubsData.find(c => c.id === clubId);
            if (!club) return;
            if (club.privateForums.length >= 2) { toast('Límite alcanzado: máximo 2 foros privados por club.'); return; }
            document.getElementById('private-forum-club-id').value = clubId;
            document.getElementById('private-forum-name').value = '';
            document.getElementById('private-forum-modal').classList.add('active');
        }
        function closePrivateForumModal() { document.getElementById('private-forum-modal').classList.remove('active'); }
        function savePrivateForum(e) {
            e.preventDefault();
            const club = fanClubsData.find(c => c.id === document.getElementById('private-forum-club-id').value);
            const name = document.getElementById('private-forum-name').value.trim();
            if (!club || !name) return;
            club.privateForums.push(name);
            saveToLocalStorage();
            closePrivateForumModal();
            openFanClubDetail(club.id);
            toast('¡Foro privado añadido!');
        }
        function deletePrivateForum(clubId, index) {
            const club = fanClubsData.find(c => c.id === clubId);
            if (club && confirm('¿Eliminar este foro privado?')) {
                club.privateForums.splice(index, 1);
                saveToLocalStorage();
                openFanClubDetail(clubId);
            }
        }
        function emptyClubMembers(clubId) {
            if (!confirm('¿Estás seguro de vaciar todos los miembros del club?')) return;
            const club = fanClubsData.find(c => c.id === clubId);
            if (club) {
                club.members = [club.manager];
                saveToLocalStorage();
                updateUserUI();
                openFanClubDetail(clubId);
                toast('El club ha sido vaciado de miembros.');
            }
        }

        /* --- Editar información del club (ventana propia, imágenes por importación) --- */
        function openEditClubModal(clubId) {
            const club = fanClubsData.find(c => c.id === clubId);
            if (!club) return;
            resetPending(['ecBanner', 'ecAvatar'], ['edit-club-banner-preview', 'edit-club-avatar-preview'], ['edit-club-banner-file', 'edit-club-avatar-file']);
            document.getElementById('edit-club-id').value = club.id;
            document.getElementById('edit-club-name').value = club.name;
            document.getElementById('edit-club-desc').value = club.description;
            document.getElementById('edit-club-price').value = club.messagePrice;
            document.getElementById('edit-club-modal').classList.add('active');
        }
        function closeEditClubModal() { document.getElementById('edit-club-modal').classList.remove('active'); }
        function saveClubInfo(e) {
            e.preventDefault();
            const club = fanClubsData.find(c => c.id === document.getElementById('edit-club-id').value);
            if (!club) return;
            club.name = document.getElementById('edit-club-name').value.trim();
            club.description = document.getElementById('edit-club-desc').value.trim();
            const price = parseFloat(document.getElementById('edit-club-price').value);
            club.messagePrice = isNaN(price) ? club.messagePrice : price;
            if (pending.ecBanner) club.banner = pending.ecBanner;
            if (pending.ecAvatar) club.avatar = pending.ecAvatar;
            saveToLocalStorage();
            closeEditClubModal();
            openFanClubDetail(club.id);
            toast('¡Información del club actualizada!');
        }

        /* --- Editar etiqueta de fandom --- */
        function promptEditTag(clubId) {
            const club = fanClubsData.find(c => c.id === clubId);
            if (!club) return;
            editingFandomClubId = clubId;
            resetPending(['efIcon'], ['edit-fandom-icon-preview'], ['edit-fandom-icon-file']);
            pending.efIcon = club.tagIconImg || '';
            if (club.tagIconImg) showPreview('edit-fandom-icon-preview', club.tagIconImg);
            document.getElementById('edit-fandom-name-input').value = club.fandomName || '';
            document.getElementById('edit-fandom-color-input').value = club.tagColor || '#ec4899';
            document.getElementById('edit-fandom-modal').classList.add('active');
        }
        function removeFandomIcon() { pending.efIcon = ''; clearPreview('edit-fandom-icon-preview'); document.getElementById('edit-fandom-icon-file').value = ''; }
        function closeEditFandomModal() {
            document.getElementById('edit-fandom-modal').classList.remove('active');
            editingFandomClubId = null;
        }
        function saveFandomTagChanges() {
            const club = fanClubsData.find(c => c.id === editingFandomClubId);
            if (!club) return;
            const newName = document.getElementById('edit-fandom-name-input').value.trim();
            if (!newName) { toast('Escribe un nombre para el fandom.'); return; }
            club.fandomName = newName;
            club.tagColor = document.getElementById('edit-fandom-color-input').value;
            club.tagIconImg = pending.efIcon || '';
            saveToLocalStorage();
            const id = club.id;
            closeEditFandomModal();
            openFanClubDetail(id);
            updateUserUI();
            toast('¡Etiqueta de fandom actualizada!');
        }

        /* ===================== INICIO ===================== */
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') {
                const open = document.querySelectorAll('.modal-overlay.active');
                if (open.length) open[open.length - 1].classList.remove('active');
                else closeSidebar();
            }
        });

        window.addEventListener('DOMContentLoaded', () => {
            document.getElementById('nav-avatar').src = DEFAULT_AVATAR;
            const savedUser = localStorage.getItem('ym_current_user');
            if (savedUser) {
                currentUsername = savedUser;
                loadUserProfile(savedUser);
                loadDashboard();
            }
        });
    </script>
</body>
</html>