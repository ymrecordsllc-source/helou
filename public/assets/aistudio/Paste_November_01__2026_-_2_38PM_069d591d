        function closeFanClubDetail() {
            document.getElementById('fan-club-detail-view').style.display = 'none';
            document.getElementById('fan-clubs-grid').style.display = 'grid';
            document.getElementById('fans-header').style.display = 'flex';
            activeClubId = null;
            renderFanClubsGrid();
        }

        function renderClubArtistsPreview(artistsList) {
            const grid = document.getElementById('club-artists-grid');
            if (!grid) return;
            grid.innerHTML = '';
            artistsList.forEach(art => {
                const card = document.createElement('div');
                card.className = 'artist-mini-card';
                card.innerHTML = `
                    <img src="${esc(avatarFor(art))}" alt="" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover; margin-bottom: 0.5rem;">
                    <h4 style="font-size: 0.95rem;">${esc(art)}</h4>
