            document.getElementById('drawer-backdrop').classList.remove('active');
        }
        function renderSidebarJoinedForums() {
            const container = document.getElementById('sidebar-joined-forums-list');
            container.innerHTML = '';
            const joined = forumsData.filter(f => f.isJoined);
            if (joined.length === 0) { container.innerHTML = `<span style="font-size: 0.85rem; color: var(--text-muted);">Sin foros unidos.</span>`; return; }
            joined.forEach(f => {
                const link = document.createElement('div');
                link.className = 'sidebar-link';
                link.innerHTML = `<img src="${esc(f.avatar)}" alt="" style="width: 24px; height: 24px; border-radius: 50%; object-fit: cover;"> <span>${esc(f.name)}</span>`;
