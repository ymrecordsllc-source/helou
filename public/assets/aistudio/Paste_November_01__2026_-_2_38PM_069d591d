        function sortBy(mode, btn) {
            currentSortMode = mode;
            document.querySelectorAll('.filter-sorts .sort-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            renderPosts();
        }

        function renderForumsPanel() {
            const joinedContainer = document.getElementById('forums-joined-grid');
            const discoverContainer = document.getElementById('forums-discover-grid');
            joinedContainer.innerHTML = ''; discoverContainer.innerHTML = '';
            forumsData.filter(f => f.isJoined).forEach(f => joinedContainer.appendChild(createForumCardElement(f, true)));
            forumsData.filter(f => !f.isJoined).forEach(f => discoverContainer.appendChild(createForumCardElement(f, false)));
        }

        function createForumCardElement(forum, isJoined) {
            const isOfficial = adminUsers.includes(forum.creator) || forum.isOfficial;
            const canManage = forum.creator === currentUsername || isUserAdmin(currentUsername);
            const id = jsq(forum.id);

            const dropdownItems = canManage ? `
                <button class="dropdown-item" onclick="event.stopPropagation(); openEditForumModal(${id})"><i class="fa-solid fa-pen-to-square"></i> Editar foro</button>
                <button class="dropdown-item danger" onclick="event.stopPropagation(); deleteForum(${id})"><i class="fa-solid fa-trash"></i> Eliminar</button>
            ` : `
                <button class="dropdown-item" onclick="event.stopPropagation(); toast('Foro silenciado')"><i class="fa-solid fa-bell-slash"></i> Silenciar</button>
                <button class="dropdown-item danger" onclick="event.stopPropagation(); toast('Foro denunciado')"><i class="fa-solid fa-triangle-exclamation"></i> Denunciar</button>
            `;

            const card = document.createElement('div');
            card.className = 'forum-card';
            card.innerHTML = `
                <div class="forum-options-container">
                    <button class="forum-options-btn" onclick="toggleForumDropdown(event, ${id})"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                    <div class="forum-dropdown-menu" id="forum-menu-${esc(forum.id)}">${dropdownItems}</div>
                </div>
                <img src="${esc(forum.banner)}" alt="" class="forum-banner">
                <div class="forum-card-body">
                    <img src="${esc(forum.avatar)}" alt="" class="forum-avatar-mini">
                    <div class="forum-card-content">
                        <div class="forum-card-title-row">
                            <h3>${esc(forum.name)}</h3>
                            ${isOfficial ? '<i class="fa-solid fa-circle-check verified-forum-badge" title="Foro Verificado Oficial"></i>' : ''}
                        </div>
                        <p class="forum-card-desc">${esc(forum.description)}</p>
                        <div class="forum-card-stats"><span><i class="fa-solid fa-users"></i> ${forum.followers}</span><span>Creado por ${esc(forum.creator)}</span></div>
                    </div>
                </div>
                <div class="forum-card-overlay">
                    ${isJoined
                        ? `<button class="btn btn-danger" style="padding:0.4rem 0.8rem; font-size:0.8rem;" onclick="event.stopPropagation(); leaveForum(${id})">Salir</button>`
                        : `<button class="btn" style="padding:0.4rem 0.8rem; font-size:0.8rem;" onclick="event.stopPropagation(); joinForum(${id})">Unirse</button>`}
                </div>
            `;
            card.onclick = () => openForumDetail(forum.id);
            return card;
        }

        function toggleForumDropdown(e, forumId) {
            e.stopPropagation();
            document.querySelectorAll('.forum-dropdown-menu').forEach(m => { if (m.id !== `forum-menu-${forumId}`) m.classList.remove('active'); });
            document.getElementById(`forum-menu-${forumId}`).classList.toggle('active');
        }
        window.addEventListener('click', () => { document.querySelectorAll('.forum-dropdown-menu').forEach(m => m.classList.remove('active')); });

        function joinForum(id) { const f = forumsData.find(x => x.id === id); if (f) { f.isJoined = true; f.followers++; saveToLocalStorage(); renderForumsPanel(); } }
        function leaveForum(id) { const f = forumsData.find(x => x.id === id); if (f) { f.isJoined = false; f.followers = Math.max(0, f.followers - 1); saveToLocalStorage(); renderForumsPanel(); } }
        function deleteForum(id) {
            if (id === 'general') { toast('El foro General no se puede eliminar.'); return; }
            if (confirm('¿Eliminar este foro y sus publicaciones?')) {
                forumsData = forumsData.filter(x => x.id !== id);
                postsData = postsData.filter(p => p.forumId !== id);
                saveToLocalStorage(); renderForumsPanel();
            }
        }

        function openForumDetail(forumId) {
            const forum = forumsData.find(f => f.id === forumId);
            if (!forum) return;
            switchForumSubview('feed');   // primero se reinicia la vista...
            activeForumFilter = forumId;  // ...y después se aplica el filtro del foro

            const wrapper = document.getElementById('forum-main-wrapper');
            wrapper.style.padding = '1.5rem';
            if (forum.bgType === 'gradient') wrapper.style.background = `linear-gradient(135deg, ${forum.bgValue || '#312e81'}, var(--bg-dark))`;
            else if (forum.bgType === 'image' && forum.bgValue) wrapper.style.background = `url("${forum.bgValue}") center/cover no-repeat`;
            else wrapper.style.background = forum.bgValue || '#0f172a';

            const isOfficial = adminUsers.includes(forum.creator) || forum.isOfficial;
            const canEdit = forum.creator === currentUsername || isUserAdmin(currentUsername);
            const editButton = canEdit ? `<button class="btn btn-outline" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;" onclick="openEditForumModal(${jsq(forum.id)})"><i class="fa-solid fa-pen"></i> Editar</button>` : '';

            const detailContainer = document.getElementById('forum-detail-view-container');
            detailContainer.style.display = 'block';
            detailContainer.innerHTML = `
                <div class="forum-detail-header">
                    <img src="${esc(forum.banner)}" alt="" class="forum-detail-banner">
                    <div class="forum-detail-info">
                        <div class="forum-detail-left">
                            <img src="${esc(forum.avatar)}" alt="" class="forum-detail-avatar">
                            <div>
                                <h2 style="font-size: 1.5rem;">${esc(forum.name)} ${isOfficial ? '<i class="fa-solid fa-circle-check verified-forum-badge"></i>' : ''}</h2>
                                <p style="color:var(--text-muted);">${esc(forum.description)}</p>
                            </div>
                        </div>
                        <div style="display: flex; gap: 0.5rem;">
                            ${editButton}
                            <button class="btn btn-outline" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;" onclick="switchForumSubview('feed')">← Salir</button>
                        </div>
                    </div>
                </div>
            `;
            renderPosts();
        }

        function renderTags() {
            const container = document.getElementById('tag-filters-container');
            container.innerHTML = '';
            const tags = ['Música', 'Audiciones', 'Fans', 'General'];
            const mk = (label, value) => {
                const btn = document.createElement('button');
                btn.className = `tag-pill ${currentTagFilter === value ? 'active' : ''}`;
                btn.textContent = label;
                btn.onclick = () => { currentTagFilter = value; renderTags(); renderPosts(); };
                container.appendChild(btn);
            };
            mk('Todas', 'all');
            tags.forEach(t => mk('#' + t, t));
        }

        function toggleForumBgInputs() {
            const t = document.getElementById('edit-bg-type').value;
            document.getElementById('edit-bg-color-group').style.display = t === 'image' ? 'none' : 'block';
            document.getElementById('edit-bg-image-group').style.display = t === 'image' ? 'block' : 'none';
        }

        function openEditForumModal(id) {
            const f = forumsData.find(x => x.id === id);
            if (!f) return;
            resetPending(['efBanner', 'efAvatar', 'efBg'], ['ef-banner-preview', 'ef-avatar-preview', 'ef-bg-preview']);
            document.querySelectorAll('#edit-forum-modal input[type=file]').forEach(i => i.value = '');
            document.getElementById('edit-forum-id').value = f.id;
            document.getElementById('edit-forum-name').value = f.name;
            document.getElementById('edit-bg-type').value = f.bgType || 'solid';
            const isHex = /^#[0-9a-f]{6}$/i.test(f.bgValue || '');
            document.getElementById('edit-bg-value').value = isHex ? f.bgValue : '#0f172a';
            toggleForumBgInputs();
            document.getElementById('edit-forum-modal').classList.add('active');
        }
        function closeEditForumModal() { document.getElementById('edit-forum-modal').classList.remove('active'); }

        function handleEditForumSubmit(e) {
            e.preventDefault();
            const id = document.getElementById('edit-forum-id').value;
            const f = forumsData.find(x => x.id === id);
            if (!f) return;
            f.name = document.getElementById('edit-forum-name').value.trim();
            f.bgType = document.getElementById('edit-bg-type').value;
            if (f.bgType === 'image') { if (pending.efBg) f.bgValue = pending.efBg; else if (!/^data:/.test(f.bgValue || '')) f.bgType = 'solid'; }
            else f.bgValue = document.getElementById('edit-bg-value').value;
            if (pending.efBanner) f.banner = pending.efBanner;
            if (pending.efAvatar) f.avatar = pending.efAvatar;
            postsData.forEach(p => { if (p.forumId === f.id) p.forumName = f.name; });
            saveToLocalStorage(); closeEditForumModal();
            if (activeForumFilter === f.id) openForumDetail(f.id); else renderForumsPanel();
            toast('Foro actualizado');
        }

        function openCreateForumModal() {
            resetPending(['cfBanner', 'cfAvatar'], ['cf-banner-preview', 'cf-avatar-preview']);
            document.getElementById('form-create-forum').reset();
            document.getElementById('create-forum-modal').classList.add('active');
        }
        function closeCreateForumModal() { document.getElementById('create-forum-modal').classList.remove('active'); }

        function handleCreateForum(e) {
            e.preventDefault();
            const name = document.getElementById('forum-name').value.trim();
            let id = name.toLowerCase().replace(/[^a-z0-9áéíóúñ]+/gi, '-').replace(/^-|-$/g, '') || 'foro';
            while (forumsData.some(f => f.id === id)) id += '-' + Math.floor(Math.random() * 1000);
            forumsData.push({
                id, name, description: document.getElementById('forum-desc').value.trim(),
                banner: pending.cfBanner || DEFAULT_BANNER, avatar: pending.cfAvatar || DEFAULT_FORUM_AVATAR,
                creator: currentUsername, followers: 1, isJoined: true, bgType: 'solid', bgValue: '#0f172a',
                isOfficial: isUserAdmin(currentUsername)
            });
            saveToLocalStorage(); closeCreateForumModal(); switchForumSubview('panel');
            toast('Foro creado');
        }

        /* ===================== PUBLICACIONES ===================== */
        function openCreatePostModal() {
            const sel = document.getElementById('post-forum-select'); sel.innerHTML = '';
            forumsData.forEach(f => { const opt = document.createElement('option'); opt.value = f.id; opt.textContent = f.name; sel.appendChild(opt); });
            if (activeForumFilter) sel.value = activeForumFilter;
            const annOpt = document.getElementById('post-type-announcement-option');
            const isAdmin = isUserAdmin(currentUsername);
            annOpt.hidden = !isAdmin; annOpt.disabled = !isAdmin;
            document.getElementById('post-type-select').value = 'normal';
            document.getElementById('create-post-modal').classList.add('active');
        }
        function closeCreatePostModal() { document.getElementById('create-post-modal').classList.remove('active'); }

        function handleCreatePost(e) {
            e.preventDefault();
            const forumId = document.getElementById('post-forum-select').value;
            const fObj = forumsData.find(f => f.id === forumId);
            const postType = document.getElementById('post-type-select').value;
            if (postType === 'announcement' && !isUserAdmin(currentUsername)) { toast('Solo los administradores pueden crear anuncios.'); return; }

            postsData.unshift({
                id: Date.now(), author: currentUsername,
                forumId, forumName: fObj ? fObj.name : 'General',
                tag: document.getElementById('post-tag-input').value.trim(),
                title: document.getElementById('post-title').value.trim(),
                content: document.getElementById('post-content').value.trim(),
                type: postType, timestamp: new Date().toISOString(), likes: 0, dislikes: 0, myReaction: null,
                comments: [], pollVotes: { option1: 0, option2: 0 }, pollVoters: []
            });
            saveToLocalStorage();
            document.getElementById('form-create-post').reset();
            closeCreatePostModal();
            if (activeForumFilter) renderPosts(); else switchForumSubview('feed');
            toast('Publicación creada');
        }

        function renderPosts() {
            const feed = document.getElementById('posts-feed');
            feed.innerHTML = '';

            let pinned = null;
            if (activeForumFilter) {
                pinned = postsData.find(p => p.forumId === activeForumFilter && p.type === 'announcement');
                if (pinned) {
                    const banner = document.createElement('div');
                    banner.className = 'pinned-announcement-banner';
                    banner.innerHTML = `
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
                            <span class="badge-announcement"><i class="fa-solid fa-bullhorn"></i> ANUNCIO OFICIAL FIJADO</span>
                            <span style="font-size: 0.75rem; color: var(--text-muted);">${esc(pinned.author)}</span>
                        </div>
                        <h4 style="font-size: 1rem; font-weight: bold; color: var(--text-main);">${esc(pinned.title)}</h4>
                        <p style="font-size: 0.85rem; color: var(--text-muted); display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;">${esc(pinned.content)}</p>
                    `;
                    const pid = pinned.id;
                    banner.onclick = () => openPostDetailModal(pid);
                    feed.appendChild(banner);
                }
            }

            const filtered = postsData.filter(post => {
                if (pinned && post.id === pinned.id) return false;
                if (activeForumFilter && post.forumId !== activeForumFilter) return false;
                if (currentTagFilter !== 'all' && post.tag !== currentTagFilter) return false;
                return true;
            });

            filtered.sort((a, b) => {
                if (currentSortMode === 'old') return new Date(a.timestamp) - new Date(b.timestamp);
                if (currentSortMode === 'controversial') {
                    const s = p => (p.likes || 0) + (p.dislikes || 0) - Math.abs((p.likes || 0) - (p.dislikes || 0));
                    return s(b) - s(a);
                }
                return new Date(b.timestamp) - new Date(a.timestamp);
            });

            if (filtered.length === 0 && !pinned) {
                feed.innerHTML = `<div style="text-align: center; color: var(--text-muted); padding: 2rem;">No hay publicaciones. ¡Sé el primero en publicar!</div>`;
                return;
            }

            filtered.forEach(post => {
                const card = document.createElement('div');
                card.className = 'post-card';
                card.onclick = () => openPostDetailModal(post.id);

                let contentRender = `<p>${esc(post.content)}</p>`;
                if (post.type === 'poll') {
                    const v = post.pollVotes || { option1: 0, option2: 0 };
                    contentRender = `
                        <p>📊 <strong>Encuesta:</strong> ${esc(post.content)}</p>
                        <button class="poll-option-btn" onclick="event.stopPropagation(); votePoll(${post.id}, 'option1')">👍 Sí / Opción A (${v.option1})</button>
                        <button class="poll-option-btn" onclick="event.stopPropagation(); votePoll(${post.id}, 'option2')">👎 No / Opción B (${v.option2})</button>
                        ${post.author === currentUsername ? `<small style="color: var(--coin-gold);">[Creador] Votos totales: ${v.option1 + v.option2}</small>` : `<small style="color: var(--text-muted);">Resultados detallados solo visibles para el creador.</small>`}
                    `;
                }

                const author = jsq(post.author);
                card.innerHTML = `
                    <div class="post-header">
                        <div class="post-author-info" onclick="event.stopPropagation(); openUserProfilePreview(${author}, ${jsq(post.avatar || '')}, '')">
                            <img src="${esc(avatarFor(post.author, post.avatar))}" alt="" class="post-author-avatar">
                            <div class="post-meta-text"><h4>${esc(post.author)}${renderUserBadges(post.author)}</h4><span>Foro: <strong>${esc(post.forumName)}</strong></span></div>
                        </div>
                        <span class="post-badge">#${esc(post.tag)}</span>
                    </div>
                    <div class="post-body"><h3>${esc(post.title)}</h3>${contentRender}</div>
                    <div class="post-footer" onclick="event.stopPropagation()">
                        <button class="post-action-btn ${post.myReaction === 'like' ? 'liked' : ''}" onclick="reactPost(${post.id}, 'like')"><i class="fa-solid fa-thumbs-up"></i> <span>${post.likes || 0}</span></button>
                        <button class="post-action-btn ${post.myReaction === 'dislike' ? 'liked' : ''}" onclick="reactPost(${post.id}, 'dislike')"><i class="fa-solid fa-thumbs-down"></i> <span>${post.dislikes || 0}</span></button>
                        <button class="post-action-btn" onclick="openPostDetailModal(${post.id})"><i class="fa-solid fa-comments"></i> <span>${post.comments ? post.comments.length : 0}</span></button>
                    </div>
                `;
                feed.appendChild(card);
            });
        }

        function reactPost(postId, type) {
            const post = postsData.find(p => p.id === postId);
            if (!post) return;
            if (post.myReaction === type) {
                if (type === 'like') post.likes--; else post.dislikes--;
                post.myReaction = null;
            } else {
                if (post.myReaction === 'like') post.likes--;
                if (post.myReaction === 'dislike') post.dislikes--;
                if (type === 'like') post.likes++; else post.dislikes++;
                post.myReaction = type;
            }
            saveToLocalStorage(); renderPosts();
        }

        function votePoll(postId, option) {
            const post = postsData.find(p => p.id === postId);
            if (!post) return;
            post.pollVoters = post.pollVoters || [];
            if (post.pollVoters.includes(currentUsername)) { toast('Ya has votado en esta encuesta.'); return; }
            post.pollVotes[option]++;
            post.pollVoters.push(currentUsername);
            saveToLocalStorage(); renderPosts();
            toast('¡Tu voto ha sido registrado!');
        }

