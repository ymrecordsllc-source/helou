                        <div>${renderFandomBadge(club)}</div>
                        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">Artistas: ${club.artists.map(esc).join(', ')}</p>
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem; display: flex; justify-content: space-between;">
                            <span><i class="fa-solid fa-users"></i> ${club.members.length} miembros</span>
                            <span>${club.members.includes(currentUsername) ? '✓ Eres miembro' : ''}</span>
                        </div>
                    </div>`;
                card.onclick = () => openFanClubDetail(club.id);
