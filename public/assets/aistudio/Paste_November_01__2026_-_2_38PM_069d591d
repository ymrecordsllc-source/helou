        const MAX_VOCAL_SECONDS = 240 + 10; // 4 min + tolerancia de 10 s

        function getMediaDuration(file) {
            return new Promise(resolve => {
                const url = URL.createObjectURL(file);
                const media = document.createElement(file.type.startsWith('video') ? 'video' : 'audio');
                const done = d => { URL.revokeObjectURL(url); resolve(d); };
                media.preload = 'metadata';
                media.onloadedmetadata = () => done(isFinite(media.duration) ? media.duration : 0);
                media.onerror = () => done(0);
                setTimeout(() => done(0), 8000);
                media.src = url;
            });
        }

        const AUDITION_FIELDS = {
            vocal: `
                <div class="form-group" style="margin-bottom:0;"><label>Seudónimo</label><input type="text" id="aud-pseudonym" required placeholder="Ej: StarVoice"></div>
                <div class="form-group" style="margin-bottom:0;"><label>Archivos de audio o video (puedes subir varios; máximo 4 minutos en total, tolerancia de 10 s)</label><input type="file" id="aud-vocal-files" accept="audio/*,video/*" multiple required></div>`,
            dance: `
                <div class="form-group" style="margin-bottom:0;"><label>Estilo de baile</label><input type="text" id="aud-dance-style" required placeholder="Ej: Hip hop, K-pop cover..."></div>
                <div class="form-group" style="margin-bottom:0;"><label>Video de baile</label><input type="file" id="aud-dance-files" accept="video/*" multiple required></div>`,
            staff: `
                <div class="form-group" style="margin-bottom:0;"><label>Área de interés</label>
                    <select id="aud-staff-area" required>
                        <option>Producción</option><option>Diseño gráfico</option><option>Edición de video</option><option>Maquillaje y estilismo</option><option>Community manager</option><option>Otra</option>
